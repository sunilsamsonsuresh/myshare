# ---------- REST API (apps/api, port 8000) ----------
DATABASE_URL=sqlite:///./myshare.db
# Used to sign user JWTs. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# ---------- MCP server (apps/mcp_server, port 8001) ----------
# Where the MCP server finds the REST API. It talks to it over HTTP like any third-party integration.
MYSHARE_API_URL=http://localhost:8000
MCP_SERVER_PORT=8001
# LangSmith tracing. Leave LANGSMITH_TRACING=false (or the key empty) to turn tracing off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=myshare
# Your account's region: https://api.smith.langchain.com (US), https://eu.api.smith.langchain.com (EU),
# https://apac.api.smith.langchain.com (APAC). A key from one region gets 403 Forbidden on the others.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Traces show steps, timings, token counts and tool names; messages, names, amounts and tool
# results are replaced by "[hidden]". true = record them in full (synthetic data only).
MYSHARE_TRACE_CONTENT=false
# stdio mode only: the user's JWT is passed via env var because there are no HTTP headers in stdio.
# MYSHARE_USER_TOKEN=

# ---------- Host (apps/host, port 8002) ----------
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5-5
# http = connect to the running MCP server at MCP_SERVER_URL (Streamable HTTP)
# stdio = the host launches the MCP server as a subprocess per user session
MCP_TRANSPORT=http
MCP_SERVER_URL=http://localhost:8001/mcp
HOST_CHECKPOINT_DB=./host_checkpoints.db
# Log every raw JSON-RPC message the host's MCP client sends/receives (to stderr + logs/mcp_wire.jsonl)
MCP_DEBUG_WIRE=0
HOST_CORS_ORIGINS=http://localhost:5173

# ---------- Web (apps/web, port 5173) ----------
VITE_API_URL=http://localhost:8000
VITE_HOST_URL=http://localhost:8002
